{
  "name": "@helbaron/markdown",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./docx": {
      "types": "./src/docx.ts",
      "default": "./src/docx.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --environment jsdom --globals",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@helbaron/shared": "workspace:*",
    "@tauri-apps/api": "2.11.0",
    "docx": "^9.14.0",
    "mammoth": "^1.13.0",
    "mdast-util-to-string": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "turndown": "^7.2.4",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/turndown": "^5.0.6",
    "jsdom": "29.1.1",
    "jszip": "^3.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
